.buttonLayout {
    width: 26%;
    height: 68%;
    margin-right: 60px;
    margin-left: 70px;
    color: rgb(255, 255, 255);
    font-size: 75px;
    -unity-text-align: middle-center;
    text-overflow: clip;
    white-space: normal;
    -unity-font-style: normal;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.textDisplay {
    align-self: center;
    top: 80px;
    -unity-font-style: italic;
}

.buttonLayout:hover {
    -unity-background-image-tint-color: rgba(182, 120, 246, 0.84);
    transition-duration: 0.5s;
    scale: 1 1;
}
